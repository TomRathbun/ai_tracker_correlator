<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="hybrid-architecture" version="22.1.0">
  <diagram id="hybrid-ops" name="Hybrid operational architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;AI Tracker Correlator&lt;/b&gt;&lt;br&gt;Operational architecture — Hybrid MLP + async Kalman (not end-to-end GNN)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=18;fontColor=#FFFFFF;fillColor=#0747A6;strokeColor=none;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="70" as="geometry"/></mxCell>
        <mxCell id="legend" value="Yellow = learned scorers (MLP / V8 slot)    Green = physics (Kalman)    Grey = rules    Blue = I/O" style="text;html=1;align=left;fontFamily=Calibri;fontSize=11;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="960" height="24" as="geometry"/></mxCell>
        <mxCell id="in" value="&lt;b&gt;01  JSONL plots&lt;/b&gt;&lt;br&gt;PSR + SSR  ·  t, x,y,z  ·  Mode-3A / Mode-S" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="168" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="win" value="&lt;b&gt;02  Window 1–2 s&lt;/b&gt;&lt;br&gt;Async scans gathered  ·  schema normalize" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F5F7;strokeColor=#42526E;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="284" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="clutter" value="&lt;b&gt;03  Clutter MLP&lt;/b&gt;&lt;br&gt;Unary P(false alarm)  ·  drop FA before association" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0B3;strokeColor=#FF8B00;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="cluster" value="&lt;b&gt;04  2 km spatial cluster&lt;/b&gt;&lt;br&gt;Pairwise MLP  (V8 slot)  ·  fuse PSR+SSR metas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0B3;strokeColor=#FF8B00;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="516" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="assign" value="&lt;b&gt;05  8 km temporal assign&lt;/b&gt;&lt;br&gt;Project track → meas_t  ·  Hungarian  ·  optional dustbin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0B3;strokeColor=#FF8B00;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="632" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="kf" value="&lt;b&gt;06  Async CV Kalman&lt;/b&gt;&lt;br&gt;dt = meas_t − track_t  ·  no window-end dragging" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3FCEF;strokeColor=#006644;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="748" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="life" value="&lt;b&gt;07  M/N track manager&lt;/b&gt;&lt;br&gt;min_hits = 2  ·  max_age = 10  ·  tentative → confirmed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F5F7;strokeColor=#42526E;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="864" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="out" value="&lt;b&gt;08  Confirmed fused tracks&lt;/b&gt;&lt;br&gt;One track per aircraft  ·  stable id  ·  scan-time latency" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="980" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="eval" value="&lt;b&gt;09  Evaluation&lt;/b&gt;&lt;br&gt;MOTA / MOTP vs interpolated GT  ·  Streamlit  ·  MLflow" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F5F7;strokeColor=#42526E;strokeWidth=2;fontFamily=Calibri;fontSize=13;fontColor=#172B4D;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="1096" width="400" height="78" as="geometry"/></mxCell>
        <mxCell id="e_in_win" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="in" target="win"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_win_clutter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="win" target="clutter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_clutter_cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="clutter" target="cluster"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cluster_assign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="cluster" target="assign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_assign_kf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="assign" target="kf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_kf_life" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="kf" target="life"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_life_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="life" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_out_eval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="out" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v8" value="&lt;b&gt;V8 slot&lt;/b&gt;&lt;br&gt;Drop-in for the two scorer diamonds only (cluster + assign). KF, Hungarian, gates and M/N stay Hybrid. Did not beat MLP on MOTA." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#EAE6FF;strokeColor=#5243AA;strokeWidth=2;fontFamily=Calibri;fontSize=11;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="24" y="516" width="276" height="194" as="geometry"/></mxCell>
        <mxCell id="e_v8_cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5243AA;dashed=1;" edge="1" parent="1" source="v8" target="cluster"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_v8_assign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#172B4D;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5243AA;dashed=1;" edge="1" parent="1" source="v8" target="assign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gnn" value="&lt;b&gt;Abandoned&lt;/b&gt;&lt;br&gt;End-to-end GNN (Recurrent GAT) owns time and initiation. MOTA −0.70" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFEBE6;strokeColor=#BF2600;strokeWidth=2;fontFamily=Calibri;fontSize=11;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="740" y="748" width="280" height="128" as="geometry"/></mxCell>
        <mxCell id="foot" value="Sweden holdout MOTA 0.976 (0 ID switches)     PlotForge UAE MOTA 0.896 after domain adapt" style="text;html=1;align=left;fontFamily=Calibri;fontSize=12;fontColor=#172B4D;fillColor=#F4F5F7;strokeColor=none;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="0" y="1464" width="1040" height="56" as="geometry"/></mxCell>
